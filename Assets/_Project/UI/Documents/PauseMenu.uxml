<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/PauseMenu.uss?fileID=7433441132597879392&amp;guid=52efa5922767795479d0d61646987056&amp;type=3#PauseMenu"/>
    <ui:VisualElement name="PauseRoot" class="pause-root">
        <ui:VisualElement class="pause-container">
            <ui:Label text="PAUSED" class="pause-title"/>
            <ui:Button name="ResumeButton" class="menu-button">
                <ui:VisualElement class="text-group">
                    <ui:Label text="RESUME" class="button-text"/>
                    <ui:VisualElement class="button-underline"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="RestartButton" class="menu-button">
                <ui:VisualElement class="text-group">
                    <ui:Label text="RESTART LEVEL" class="button-text"/>
                    <ui:VisualElement class="button-underline"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="MenuButton" class="menu-button">
                <ui:VisualElement class="text-group">
                    <ui:Label text="MAIN MENU" class="button-text"/>
                    <ui:VisualElement class="button-underline"/>
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
