<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/GameOver.uss?fileID=7433441132597879392&amp;guid=9f6deb10d625d6747987680a2bd66405&amp;type=3#GameOver"/>
    <ui:VisualElement name="GameOverRoot" class="gameover-root">
        <ui:VisualElement class="gameover-container">
            <ui:Label text="OVERLOADED" class="gameover-title"/>
            <ui:Label text="Your soul shattered past 21 grams." class="gameover-subtitle"/>
            <ui:Button name="GameOverRestartButton" class="menu-button">
                <ui:VisualElement class="text-group">
                    <ui:Label text="TRY AGAIN" class="button-text"/>
                    <ui:VisualElement class="button-underline"/>
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
