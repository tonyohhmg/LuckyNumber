.gameover-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(15, 3, 3, 0.85);
}

.gameover-container {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 100, 100, 0.35);
    border-width: 1px;
    border-radius: 20px;
    padding: 50px 70px;
    align-items: center;
    width: auto;
    box-shadow: 0 0 50px rgba(255, 100, 100, 0.1);
}

.gameover-title {
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-bottom: 32px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=859cccd890b6eb4429fb1986cea742e4&type=3#LilitaOne-Regular");
    height: 64px;
    -unity-text-align: middle-left;
}

.gameover-subtitle {
    font-size: 18px;
    color: rgba(255, 200, 200, 0.75);
    margin-bottom: 40px;
    letter-spacing: 1.5px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
}

.gameover-button {
    background-color: rgba(255, 100, 100, 0.12);
    border-color: rgba(255, 100, 100, 0.7);
    border-width: 1.5px;
    border-radius: 12px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 16px 50px;
    letter-spacing: 4px;
    width: 100%;
    margin-bottom: 0;
    transition-duration: 0.3s;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
    -unity-text-align: middle-center;
    align-self: center;
    align-items: center;
    padding-top: 16px;
    height: auto;
    padding-bottom: 12px;
}

.gameover-button:hover {
    background-color: rgba(255, 100, 100, 0.3);
    border-color: rgb(255, 255, 255);
    box-shadow: 0 0 20px rgba(255, 100, 100, 0.4);
}
