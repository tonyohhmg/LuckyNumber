.gamewon-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 15, 10, 0.85);
}

.gamewon-container {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 215, 0, 0.45);
    border-width: 1.5px;
    border-radius: 20px;
    padding: 55px 75px;
    align-items: center;
    width: 640px;
    box-shadow: 0 0 60px rgba(255, 215, 0, 0.12);
}

.gamewon-title {
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-bottom: 32px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=859cccd890b6eb4429fb1986cea742e4&type=3#LilitaOne-Regular");
    height: auto;
    -unity-text-align: middle-center;
    width: 480px;
    white-space: pre-wrap;
}

.gamewon-subtitle {
    font-size: 18px;
    color: rgba(255, 240, 180, 0.8);
    margin-bottom: 40px;
    letter-spacing: 2px;
    text-align: center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
}

.gamewon-button {
    background-color: rgba(255, 215, 0, 0.15);
    border-color: rgba(255, 215, 0, 0.8);
    border-width: 1.5px;
    border-radius: 12px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 16px 50px;
    letter-spacing: 4px;
    width: 100%;
    margin-bottom: 0;
    transition-duration: 0.3s;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
    -unity-text-align: middle-center;
    align-self: center;
    align-items: center;
    padding-top: 16px;
    height: auto;
    padding-bottom: 12px;
}

.gamewon-button:hover {
    background-color: rgba(255, 215, 0, 0.35);
    border-color: rgb(255, 255, 255);
    box-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
    scale: 1.02;
}
