.menu-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 7, 14, 0.75);
}

.menu-container {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(165, 242, 243, 0.25);
    border-width: 1px;
    border-radius: 24px;
    padding: 60px 80px;
    align-items: center;
    justify-content: center;
    width: auto;
    box-shadow: 0 0 50px rgba(165, 242, 243, 0.05);
}

.game-title {
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-bottom: 32px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=859cccd890b6eb4429fb1986cea742e4&type=3#LilitaOne-Regular");
    height: 64px;
    -unity-text-align: middle-left;
}

.game-subtitle {
    font-size: 18px;
    color: rgba(165, 242, 243, 0.75);
    letter-spacing: 3px;
    margin-bottom: 50px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
}

.menu-button {
    background-color: rgba(165, 242, 243, 0.08);
    border-color: rgba(165, 242, 243, 0.5);
    border-width: 1.5px;
    border-radius: 12px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 16px 50px;
    letter-spacing: 4px;
    width: 100%;
    margin-bottom: 24px;
    transition-duration: 0.3s;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
    -unity-text-align: middle-center;
    align-self: center;
    align-items: center;
    padding-top: 16px;
    height: auto;
    padding-bottom: 12px;
}

.menu-button:hover {
    background-color: rgba(165, 242, 243, 0.25);
    border-color: rgb(255, 255, 255);
    scale: 1.02;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 20px rgba(165, 242, 243, 0.4);
}

.controls-hint {
    margin-top: 20px;
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
}

.hint-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
}
