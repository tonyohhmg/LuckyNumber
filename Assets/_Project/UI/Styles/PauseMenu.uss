.pause-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 7, 16, 0.863);
    backdrop-filter: blur(4);
}

.pause-container {
    background-color: rgba(3, 7, 16, 0);
    border-color: rgba(165, 242, 243, 0.25);
    border-width: 1px;
    border-radius: 20px;
    padding: 45px 65px;
    align-items: center;
    width: 460px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.pause-title {
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-bottom: 32px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/LilitaOne-Regular.ttf?fileID=12800000&guid=859cccd890b6eb4429fb1986cea742e4&type=3#LilitaOne-Regular");
    height: 64px;
    -unity-text-align: middle-left;
}

.menu-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 50px;
    width: auto;
    margin-bottom: 32px;
    padding: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    -unity-text-align: upper-center;
    picking-mode: position;
}

.menu-button > * {
    picking-mode: ignore;
}

.text-group {
    align-items: center;
    justify-content: center;
    position: relative;
    height: 100%;
    width: 100%;
}

.button-text {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: normal;
    letter-spacing: 4px;
    transition-property: color;
    transition-duration: 0.2s;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    -unity-text-align: middle-center;
}

.button-underline {
    position: absolute;
    bottom: 2px;
    left: 50%;
    height: 2px;
    width: 0%;
    background-color: rgb(255, 255, 255);
    transition-property: width, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    translate: -50% 0;
}

.menu-button:hover .button-underline {
    width: 100%;
}

.menu-button:focus .button-text {
    scale: 1.1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
}
