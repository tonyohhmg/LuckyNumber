.menu-root {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    background-color: rgb(3, 7, 16);
    backdrop-filter: blur(4);
    background-image: url("project://database/Assets/_Project/Art/background.png?fileID=2800000&guid=cf26f2120108b1940aa3a485b7c9de15&type=3#background");
}

.menu-layout-wrapper {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-between;
    padding-top: 48px;
    padding-right: 48px;
    padding-bottom: 48px;
    padding-left: 48px;
}

.menu-container {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(165, 242, 243, 0.25);
    border-width: 1px;
    border-radius: 24px;
    padding: 60px 80px;
    align-items: center;
    justify-content: center;
    width: auto;
    right: auto;
    position: relative;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    left: 124px;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    flex-direction: column;
}

.game-title-logo {
    width: 200px;
    height: 82.12px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 32px;
    background-image: url("project://database/Assets/_Project/Art/logo.svg?fileID=7388822144124034973&guid=4c95fa90ba4566b469072027252449f7&type=3#logo");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

.divider {
    background-image: url("project://database/Assets/_Project/Art/divider.svg?fileID=7388822144124034973&guid=fda28bf8ffc2cb449998fd286a9d3b52&type=3#divider");
    height: 16.97px;
    width: 250px;
}

.game-subtitle {
    font-size: 18px;
    color: rgb(165, 242, 243);
    letter-spacing: 3px;
    margin-bottom: 48px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
    margin-top: 24px;
}

.menu-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 50px;
    width: auto;
    margin-bottom: 32px;
    padding: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    -unity-text-align: upper-center;
}

.text-group {
    align-items: center;
    justify-content: center;
    position: relative;
    height: 100%;
    width: 100%;
}

.button-text {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: normal;
    letter-spacing: 4px;
    transition-property: color;
    transition-duration: 0.2s;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    -unity-text-align: middle-center;
    align-self: center;
}

.button-underline {
    position: absolute;
    bottom: 2px;
    left: 50%;
    height: 2px;
    width: 0%;
    background-color: rgb(255, 255, 255);
    transition-property: width, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    translate: -50% 0;
}

.menu-button:hover .button-underline {
    width: 100%;
}

.menu-button:active .button-text {
    color: rgb(170, 180, 190);
    scale: 0.97;
}

.menu-button:focus .button-text {
    scale: 1.1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
}

.controls-container {
    margin-top: 24px;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.control-group {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

.gamepad-control-group {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

.control-group-two {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    align-self: flex-end;
    margin-top: 12px;
}

.control-item {
    flex-direction: column;
    align-items: center;
    margin-right: 12px;
    margin-left: 12px;
}

.wasd-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.wasd-top-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 2px;
}

.wasd-bottom-row {
    flex-direction: row;
    justify-content: center;
}

.keycap-group {
    flex-direction: row;
    align-items: center;
}

.keycap {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(165, 242, 243, 0.4);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    margin-right: 3px;
    margin-left: 3px;
    min-width: 24px;
    min-height: 24px;
    padding-top: 6px;
    width: 32px;
    height: 32px;
    border-left-color: rgb(56, 60, 67);
    border-right-color: rgb(56, 60, 67);
    border-top-color: rgb(56, 60, 67);
    border-bottom-color: rgb(56, 60, 67);
}

.wide-keycap {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(165, 242, 243, 0.4);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    margin-right: 3px;
    margin-left: 3px;
    min-width: 24px;
    min-height: 24px;
    padding-top: 6px;
    height: 32px;
    border-left-color: rgb(56, 60, 67);
    border-right-color: rgb(56, 60, 67);
    border-top-color: rgb(56, 60, 67);
    border-bottom-color: rgb(56, 60, 67);
}

.icon-keycap {
    background-color: rgba(255, 255, 255, 0);
    border-color: rgba(165, 242, 243, 0.4);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    margin-right: 3px;
    margin-left: 3px;
    min-width: 24px;
    min-height: 24px;
    padding-top: 6px;
    width: 32px;
    height: 32px;
    border-left-color: rgb(56, 60, 67);
    border-right-color: rgb(56, 60, 67);
    border-top-color: rgb(56, 60, 67);
    border-bottom-color: rgb(56, 60, 67);
}

.control-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.706);
    letter-spacing: 1px;
    margin-left: 0;
    margin-right: 0;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
    -unity-text-align: upper-center;
    align-self: center;
    align-items: center;
    justify-content: center;
    align-content: center;
    margin-top: 8px;
}

.l-stick-icon {
    background-image: url("project://database/Assets/_Project/Art/right-stick.svg?fileID=7388822144124034973&guid=d5b455c921bd62a478dfe744f661d18b&type=3#right-stick");
    width: 32px;
    height: 26px;
}

.r-stick-icon {
    background-image: url("project://database/Assets/_Project/Art/left-stick.svg?fileID=7388822144124034973&guid=d1bb442a393e49843941ad20f9737dad&type=3#left-stick");
    width: 32px;
    height: 26px;
}

.l-trigger-icon {
    background-image: url("project://database/Assets/_Project/Art/left-trigger.svg?fileID=7388822144124034973&guid=2407f520efca9434c9003ceb2c25db42&type=3#left-trigger");
    width: 32px;
    height: 26px;
}

.r-trigger-icon {
    background-image: url("project://database/Assets/_Project/Art/right-trigger.svg?fileID=7388822144124034973&guid=b38cac5b1a532724baf1121c4572f878&type=3#right-trigger");
    width: 32px;
    height: 26px;
}

.x-button-icon {
    background-image: url("project://database/Assets/_Project/Art/x-button.svg?fileID=7388822144124034973&guid=29cda5acff964f94b9f9cfd560ba2150&type=3#x-button");
    width: 26px;
    height: 26px;
}

.secondary-button {
    align-content: flex-end;
    align-self: flex-start;
    bottom: 0;
    position: absolute;
    right: 48px;
}

.options-panel {
    background-color: rgba(3, 7, 16, 0.863);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 48px;
    padding-bottom: 48px;
    flex-grow: 0;
    height: 480px;
    width: 480px;
    justify-content: flex-start;
    align-self: center;
    margin-right: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    right: 124px;
}

.options-title {
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Bold.ttf?fileID=12800000&guid=03df7106d03eff243a35ba1fed28ab56&type=3#Overpass-Bold");
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
}

.option-item {
    margin-bottom: 16px;
}

.option-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    -unity-text-align: middle-left;
    align-self: stretch;
}

.option-value-label {
    color: rgb(165, 242, 243);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Regular.ttf?fileID=12800000&guid=b216ab5c5d76f8043a9afa13090ae148&type=3#Overpass-Regular");
    font-size: 16px;
}

.option-label {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Overpass-Medium.ttf?fileID=12800000&guid=a4d0cc1796036f04c8eac4fbc86455a6&type=3#Overpass-Medium");
    font-size: 18px;
    height: 24px;
    margin-bottom: 8px;
    -unity-font-style: normal;
    -unity-text-align: upper-left;
}

.custom-slider {
    height: 24px;
    justify-content: center;
    position: relative;
    padding-left: 4px;
    padding-right: 4px;
}

.custom-slider-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.078);
    border-color: rgba(165, 242, 243, 0.25);
    border-width: 1px;
    border-radius: 3px;
    overflow: hidden;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.custom-slider-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(165, 242, 243, 0.078);
}

.custom-slider-thumb {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    border-color: rgb(165, 242, 243);
    border-width: 2px;
    left: 98%;
    translate: -50% 0;
    transition-property: scale;
    transition-duration: 0.12s;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    filter: none;
}

.custom-slider:hover .custom-slider-thumb {
    scale: 1.2;
}

.custom-toggle {
    width: 46px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(165, 242, 243, 0.3);
    border-width: 1px;
    padding: 3px;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.custom-toggle:hover {
    border-color: rgb(255, 255, 255);
}

.custom-toggle-knob {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.6);
    translate: 0 0;
    transition-property: translate, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.custom-toggle--checked {
    background-color: rgba(165, 242, 243, 0.25);
    border-color: rgb(165, 242, 243);
}

.custom-toggle--checked .custom-toggle-knob {
    background-color: rgb(165, 242, 243);
    translate: 22px 0;
}
